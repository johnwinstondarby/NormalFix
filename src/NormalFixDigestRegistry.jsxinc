    function copyRows() {
        var out = [];
        var i, row;

        for (i = 0; i < ROWS.length; i++) {
            row = ROWS[i];
            out.push({
                "Key": row["Key"],
                "Category": row["Category"],
                "Snapshot Role": row["Snapshot Role"],
                "Digest Role": row["Digest Role"],
                "Proof / Evidence": row["Proof / Evidence"]
            });
        }

        return out;
    }

    function keys() {
        var out = [];
        var i;

        for (i = 0; i < ROWS.length; i++) {
            out.push(ROWS[i]["Key"]);
        }

        return out;
    }

    function paragraphProperties() {
        var out = [];
        var i, key;

        for (i = 0; i < ROWS.length; i++) {
            key = ROWS[i]["Key"];
            if (ROWS[i]["Category"] === "paragraph" &&
                key.indexOf("paragraph.") === 0 &&
                key !== "paragraph.appliedParagraphStyle" &&
                key !== "paragraph.overrideState") {
                out.push(key.substring("paragraph.".length));
            }
        }

        return out;
    }

    function characterProperties() {
        var out = [];
        var i, key;

        for (i = 0; i < ROWS.length; i++) {
            key = ROWS[i]["Key"];
            if (ROWS[i]["Category"] === "character" &&
                key.indexOf("characters.") === 0) {
                out.push(key.substring("characters.".length));
            }
        }

        return out;
    }

    function validate() {
        var seen = {};
        var i, key;

        if (ROWS.length !== FROZEN_KEY_COUNT) {
            return {ok:false, reason:"Frozen registry key count mismatch."};
        }

        for (i = 0; i < ROWS.length; i++) {
            key = String(ROWS[i]["Key"] || "");
            if (key.length === 0) {
                return {ok:false, reason:"Frozen registry contains an empty key."};
            }
            if (seen[key]) {
                return {ok:false, reason:"Frozen registry contains duplicate key: " + key};
            }
            seen[key] = true;
        }

        if (paragraphProperties().length !== 180) {
            return {ok:false, reason:"Paragraph property count mismatch."};
        }

        if (characterProperties().length !== 53) {
            return {ok:false, reason:"Character property count mismatch."};
        }

        return {ok:true, reason:""};
    }

    return {
        VERSION: VERSION,
        SOURCE_SHA256: SOURCE_SHA256,
        FROZEN_KEY_COUNT: FROZEN_KEY_COUNT,
        rows: copyRows,
        keys: keys,
        paragraphProperties: paragraphProperties,
        characterProperties: characterProperties,
        validate: validate
    };
}());
